{
  "name": "@inzaiq/agentic-ecommerce",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "node --import tsx scripts/db-migrate.ts",
    "auth:migrate": "node --import tsx scripts/auth-migrate.ts --apply",
    "demo:setup": "node --import tsx scripts/setup-demo.ts",
    "demo": "npm run demo:setup && next dev",
    "verify": "npm run typecheck && npm test && npm run build",
    "doctor": "node --import tsx scripts/doctor.ts",
    "configure": "node --import tsx scripts/configure.ts",
    "test:e2e": "playwright test",
    "capacity:check": "node deploy/enterprise/check-budget.mjs",
    "test:load": "k6 run tests/load/read-journeys.js"
  },
  "dependencies": {
    "@better-auth/cimd": "1.7.10",
    "@better-auth/mcp": "1.7.10",
    "@better-auth/oauth-provider": "1.7.10",
    "@libsql/client": "0.18.0",
    "@libsql/kysely-libsql": "0.4.1",
    "@modelcontextprotocol/server": "2.3.1",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-metrics-otlp-http": "0.223.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@opentelemetry/sdk-metrics": "2.12.0",
    "@opentelemetry/sdk-node": "0.223.0",
    "@radix-ui/react-dialog": "1.3.1",
    "better-auth": "1.7.10",
    "kysely": "0.29.6",
    "lucide-react": "1.58.0",
    "next": "16.4.2",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "stripe": "23.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@modelcontextprotocol/client": "2.3.1",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
