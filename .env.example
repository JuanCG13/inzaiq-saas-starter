# Copy to .env.local; never commit credentials.
# sqlite = local persistent development. turso = libsql cloud.
# postgres/supabase/neon = PostgreSQL through pg (pooler-compatible, no named prepared statements).
DATABASE_PROVIDER=sqlite
DATABASE_URL=file:./commerce.db
# TURSO_AUTH_TOKEN=
# For PostgreSQL use the provider connection string with sslmode=verify-full (or its documented verified TLS setting).
# Use a direct/session connection for migrations; transaction pooler for application requests.
# Per Node process. Budget: peak replicas * processes per replica * pool + workers + migrations.
# Bounds: pool 1..100; connection timeout 100..60000 ms; idle timeout 1000..600000 ms.
PG_POOL_MAX=5
PG_CONNECTION_TIMEOUT_MS=10000
PG_IDLE_TIMEOUT_MS=30000
APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
# Set to an organization ID that exists after account creation/onboarding.
STORE_TENANT_ID=
DEMO_MODE=false
# Optional server-side OTLP; no frontend secrets.
OTEL_SERVICE_NAME=agentic-commerce
# OTEL_EXPORTER_OTLP_ENDPOINT=https://your-collector.example.com
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer YOUR_COLLECTOR_TOKEN
LOG_LEVEL=info

# Build-time release identity and optional versioned immutable asset CDN.
# DEPLOYMENT_VERSION=reviewed-git-commit
# NEXT_ASSET_PREFIX=https://cdn.example.com/releases/RELEASE_ID

# Hosted checkout: manual by default; stripe requires BOTH keys and webhook setup.
PAYMENT_PROVIDER=manual
# Inject a restricted API key (rk_) with Checkout write permission from your secret manager.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# Stable across retries; label must end in 8 letters. Default is already valid.
# STRIPE_INTEGRATION_IDENTIFIER=agentic-commerce-kpvqbzcw
